{
  "_comment": "겜코리아 자동화 실행 모드 설정",
  "_version": "3.0",
  "_updated": "2026-05-06",
  "architecture": {
    "principle": "서치팀과 숏츠팀은 독립적으로 운영한다",
    "search_team": "researcher → data_organizer → category_ai → map_marker",
    "shorts_team": "shorts_ai → review_ai",
    "rules": [
      "콘텐츠팀은 직접 서치하지 않는다",
      "콘텐츠팀은 heritage_all.json 기존 데이터만 사용한다",
      "콘텐츠는 삭제하지 않고 자산으로 저장한다",
      "중복 장소는 병합 관리한다",
      "대표 승인 전 업로드 금지"
    ]
  },
  "modes": {
    "A_MODE_FAST_SEARCH": {
      "name": "A모드 — 빠른 서치 전용",
      "interval_minutes": 8,
      "search_enabled": true,
      "content_enabled": false,
      "default_mode": false,
      "purpose": "초기 마커 확보용. 가능한 많은 역사문화유산 데이터를 빠르게 수집한다.",
      "pipeline_steps": [
        "researcher",
        "data_organizer",
        "category_ai",
        "map_marker"
      ],
      "quality_tasks": [],
      "status_transitions": {
        "on_search_complete": "data_status → complete",
        "on_map_ready": "map_status → ready",
        "on_no_coords": "map_status → geocoding_needed"
      }
    },
    "B_MODE_QUALITY_SEARCH": {
      "name": "B모드 — 품질 중심 서치 (기본 운영 모드)",
      "interval_minutes": 30,
      "search_enabled": true,
      "content_enabled": false,
      "default_mode": true,
      "purpose": "공식 출처 기반 데이터 품질 강화. 기본 운영 모드.",
      "pipeline_steps": [
        "researcher",
        "data_organizer",
        "category_ai",
        "map_marker"
      ],
      "quality_tasks": [
        "중복 검토: place_id 기준 기존 데이터와 비교 병합",
        "주소 보강: 지번 주소 → 도로명 주소로 교체",
        "좌표 확인: 기존 좌표 정확도 재검토 (needs_geocoding 재판정)",
        "카테고리 보강: category_sub·tags 누락 항목 보완"
      ],
      "status_transitions": {
        "on_search_complete": "data_status → complete",
        "on_map_ready": "map_status → ready",
        "on_no_coords": "map_status → geocoding_needed",
        "on_quality_updated": "last_updated → 현재 시각"
      }
    },
    "C_MODE_SHORTS_AUTOMATION": {
      "name": "C모드 — 숏츠 콘텐츠 생성 전용",
      "interval_minutes": null,
      "search_enabled": false,
      "content_enabled": true,
      "content_limit_per_run": 5,
      "default_mode": false,
      "purpose": "기존 데이터를 숏츠 콘텐츠로 전환. 서치 없이 독립 실행.",
      "pipeline_steps": [
        "shorts_ai",
        "review_ai"
      ],
      "data_source": "heritage_all.json (기존 데이터만 사용)",
      "generates": [
        "숏츠 대본 (30초 / 60초)",
        "후킹 문장 5개",
        "썸네일 문구 5개",
        "플랫폼별 캡션 (유튜브·인스타·틱톡·샤오홍슈)",
        "해시태그"
      ],
      "content_conditions": {
        "content_status": "waiting",
        "data_status": "complete",
        "map_status": [
          "ready",
          "published",
          "video_linked"
        ],
        "source_urls_required": true,
        "data_confidence": [
          "high",
          "medium"
        ],
        "required_fields": [
          "name",
          "category",
          "period",
          "region",
          "short_description"
        ]
      },
      "priority_order": [
        "data_confidence = high 우선",
        "source_urls 수 많은 것 우선",
        "period_category = 근대 / 조선 후기 우선",
        "tags 수 많은 것 우선"
      ],
      "status_transitions": {
        "on_content_start": "content_status → generating",
        "on_content_done": "content_status → review_pending",
        "on_review_approve": "content_status → created",
        "on_review_revise_reject": "content_status → archived"
      }
    }
  },
  "common_rules": {
    "dedup_key": "place_id",
    "no_upload_before_approval": true,
    "save_all_scripts": true,
    "retry_on_error": true,
    "error_log_path": "logs/error_log.json",
    "run_log_path": "logs/automation_log.json"
  },
  "file_paths": {
    "search_results": "data/raw/search_results.json",
    "heritage_places": "data/processed/heritage_places.json",
    "markers_ready": "map/markers_ready.json",
    "markers_geocoding_needed": "map/markers_geocoding_needed.json",
    "scripts_created": "content/scripts_created.json",
    "automation_log": "logs/automation_log.json",
    "error_log": "logs/error_log.json"
  },
  "category_scope": {
    "역사": {
      "status": "active",
      "subcategories": [
        "고인돌/선사유적",
        "궁궐/왕실",
        "성곽/산성",
        "사찰/불교유산",
        "비석/기념유산",
        "독립운동/근현대",
        "고택/서원/향교"
      ],
      "note": "현재 수집 중"
    },
    "자연": {
      "status": "prepared",
      "subcategories": [
        "산",
        "바다/해변",
        "강/호수",
        "숲/공원",
        "폭포",
        "동굴",
        "섬",
        "자연명승",
        "일출/일몰 명소",
        "계절 명소"
      ],
      "note": "자연 서치 시작 명령 시 활성화"
    },
    "문화/체험": {
      "status": "prepared",
      "subcategories": [
        "전통시장",
        "박물관",
        "미술관",
        "체험마을",
        "축제",
        "전통문화 체험",
        "공방 체험",
        "지역 먹거리",
        "로컬 여행 코스",
        "가족 체험"
      ],
      "note": "문화·체험 서치 시작 명령 시 활성화"
    }
  }
}